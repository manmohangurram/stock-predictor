# Development only. Copy to `.env` (gitignored) — this file never ships, and the app never writes
# anything from here into the database.
#
# The app's four deployment variables are BIND, DB_PATH, PUBLIC_URL and SECRET_KEY. Everything else
# is a settings row edited in the UI. A model key here is a *fallback*: if a key is stored in
# Settings, the stored one wins.

# So prompts can be exercised locally without storing a key at rest.
DEEPSEEK_API_KEY=sk-...

# Optional: a proxy for outbound calls while developing (Settings → Network is the real control).
# HTTP_PROXY=http://127.0.0.1:8080

# Optional: where to listen and which database to use. Without these: 0.0.0.0:8080 and
# data/stock-predictor.db — the container defaults.
# BIND=127.0.0.1:8099
# DB_PATH=/tmp/dev.db
# PUBLIC_URL=http://127.0.0.1:8099
# SECRET_KEY=64-hex-characters
