# Compose reads this file for ${…} substitution. The app itself reads only the process
# environment and never opens a file, so keep the values here and let Compose pass them in.
#
# chmod 600 .env

# 32 bytes, 64 hex characters or base64. Encrypts the API key, ntfy token and proxy password.
# Losing it means re-entering them.
SECRET_KEY=

# The address you reach this at, used for the deep link on a notification. No trailing slash.
PUBLIC_URL=http://192.168.1.10:8080

RUST_LOG=info
